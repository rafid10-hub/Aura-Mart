  >

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "OnlineStore",
    "name": "Aura Mart",
    "url": "https://rafid10-hub.github.io/Aura-Mart/",
    "description": "Aura Mart is an online shop in Bangladesh offering fashion, bags, accessories and lifestyle products.",
    "areaServed": {
      "@type": "Country",
      "name": "Bangladesh"
    }
  }
  </script>

  <style>

    :root {
      --ink: #14211d;
      --pine: #1f5b4b;
      --pine-dark: #164638;
      --lime: #dff25b;
      --cream: #fbf8f0;
      --rose: #f4d7c9;
      --white: #ffffff;
      --muted: #5c6b64;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: var(--ink);
      background: var(--cream);
      font-family: "Hind Siliguri", sans-serif;
    }

    .wrap {
      width: min(1120px, calc(100% - 40px));
      margin: auto;
    }

    /* ================= HEADER ================= */

    header {
      padding: 21px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .brand {
      font: 800 27px Outfit, sans-serif;
      letter-spacing: -1.2px;
      white-space: nowrap;
    }

    .brand span {
      color: var(--pine);
    }

    nav {
      display: flex;
      gap: 26px;
      align-items: center;
    }

    nav a {
      color: var(--ink);
      text-decoration: none;
      font-weight: 600;
    }

    nav a:hover {
      color: var(--pine);
    }

    /* ================= BUTTON ================= */

    .button {
      border: 0;
      background: var(--pine);
      color: white;
      text-decoration: none;
      padding: 12px 20px;
      border-radius: 100px;
      display: inline-block;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s ease;
    }

    .button:hover {
      transform: translateY(-2px);
      background: var(--pine-dark);
    }

    /* ================= HERO ================= */

    .hero {
      padding: 58px 0 78px;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: 45px;
    }

    .tag {
      display: inline-block;
      color: var(--pine);
      background: #e7f0d6;
      padding: 7px 14px;
      border-radius: 99px;
      font-size: 14px;
      font-weight: 700;
    }

    h1 {
      font: 800 clamp(44px, 6vw, 75px) / 0.98 Outfit, sans-serif;
      letter-spacing: -3.5px;
      margin: 18px 0;
    }

    h1 em {
      color: var(--pine);
      font-style: normal;
    }

    .lead {
      font-size: 19px;
      line-height: 1.6;
      max-width: 510px;
      margin: 0 0 27px;
    }

    /* ================= HERO ART ================= */

    .hero-art {
      min-height: 400px;
      background: var(--rose);
      position: relative;
      overflow: hidden;
      border-radius: 42% 42% 26px 26px;
      display: grid;
      place-items: center;
    }

    .bag {
      width: 205px;
      height: 210px;
      background: var(--lime);
      border-radius: 22px 22px 38px 38px;
      position: relative;
      transform: rotate(-8deg);
      box-shadow: 18px 19px 0 #b9d651;
    }

    .bag:before {
      content: "";
      position: absolute;
      width: 92px;
      height: 65px;
      border: 13px solid var(--pine);
      border-bottom: 0;
      border-radius: 55px 55px 0 0;
      left: 44px;
      top: -52px;
    }

    .bag:after {
      content: "A";
      font: 800 105px Outfit, sans-serif;
      color: var(--pine);
      position: absolute;
      left: 61px;
      top: 43px;
    }

    .flower {
      position: absolute;
      width: 128px;
      height: 128px;
      border-radius: 50%;
      border: 27px dotted #fff6e6;
      right: -20px;
      top: 30px;
    }

    .spark {
      position: absolute;
      color: var(--pine);
      font-size: 58px;
      bottom: 35px;
      left: 44px;
    }

    /* ================= SECTIONS ================= */

    .section {
      padding: 52px 0;
    }

    .section-title {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 20px;
      margin-bottom: 20px;
    }

    h2 {
      font: 800 34px Outfit, sans-serif;
      letter-spacing: -1.5px;
      margin: 0;
    }

    /* ================= PRODUCTS ================= */

    .products {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .card {
      background: white;
      padding: 15px;
      border-radius: 20px;
      box-shadow: 0 8px 24px #17342b0d;
      transition: 0.2s ease;
    }

    .card:hover {
      transform: translateY(-4px);
    }

    .visual {
      height: 200px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      font-size: 92px;
    }

    .v1 {
      background: #eee1d6;
    }

    .v2 {
      background: #dae7df;
    }

    .v3 {
      background: #e6dcf0;
    }

    .card h3 {
      font-size: 19px;
      margin: 13px 0 2px;
    }

    .price {
      color: var(--pine);
      font-weight: 700;
      margin: 0;
    }

    /* ================= ABOUT ================= */

    .about {
      background: var(--pine);
      color: white;
      border-radius: 25px;
      padding: 35px;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 30px;
      align-items: center;
    }

    .about h2 {
      font-size: 39px;
    }

    .about p {
      font-size: 18px;
      line-height: 1.65;
    }

    .points {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .point {
      padding: 14px;
      background: #ffffff17;
      border-radius: 12px;
      font-weight: 600;
    }

    /* ================= FOOTER ================= */

    footer {
      padding: 36px 0 45px;
      text-align: center;
      color: var(--muted);
    }

    footer p {
      margin: 7px;
    }

    /* ================= MOBILE ================= */

    @media (max-width: 720px) {

      .wrap {
        width: min(100% - 28px, 1120px);
      }

      header {
        padding: 17px 0;
      }

      nav {
        gap: 8px;
      }

      nav a:not(.button) {
        display: none;
      }

      nav .button {
        padding: 10px 15px;
        font-size: 14px;
      }

      .hero {
        grid-template-columns: 1fr;
        padding-top: 35px;
        gap: 30px;
      }

      .hero-art {
        min-height: 300px;
        order: -1;
      }

      h1 {
        font-size: clamp(42px, 14vw, 62px);
        letter-spacing: -2px;
      }

      .lead {
        font-size: 17px;
      }

      .products {
        grid-template-columns: 1fr;
      }

      .about {
        grid-template-columns: 1fr;
        padding: 28px 22px;
      }

      .about h2 {
        font-size: 32px;
      }

      .points {
        grid-template-columns: 1fr 1fr;
      }

      .section-title {
        display: block;
      }

      .section-title span {
        display: block;
        margin-top: 7px;
      }
    }

    @media (max-width: 420px) {

      .brand {
        font-size: 23px;
      }

      .points {
        grid-template-columns: 1fr;
      }

      .hero-art {
        min-height: 270px;
      }

      .bag {
        transform: scale(0.85) rotate(-8deg);
      }
    }

  </style>

</head>

<body>

  <div class="wrap">

    <!-- ================= HEADER ================= -->

